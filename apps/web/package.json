{
  "name": "@jpaper/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "用語集を閲覧・編集し、訳文と PDF に置換で反映するローカル Web アプリ",
  "scripts": {
    "dev": "vite",
    "server": "tsx watch server/main.ts",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.server.json && vite build",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.server.json"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "hono": "^4.13.13",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tsx": "^4.23.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.3"
  }
}
