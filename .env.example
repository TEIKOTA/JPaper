# jpaper が読む環境変数のひな形。
#
# 使い方: このファイルを .env に複製して値を入れる。.env は gitignore 済み。
#   cp .env.example .env
#
# .env を読むのは jpaper CLI のプロセス入口だけで、ライブラリ経路とテストでは読まない。
# 既にシェルや CI で設定されている変数は .env より優先される（.env は既定値として働く）。

# ── 外部プロバイダの資格情報 ──────────────────────────────
# OpenRouter の API キー。--provider openrouter を使うときだけ必要。
# 取得: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ── 開発・デバッグ用（省略可） ────────────────────────────
# 用語集 DB の置き場。既定は ~/.jpaper。空の DB で測りたいときに別ディレクトリを指す。
# JPAPER_HOME=

# 契約に合わない LLM 応答の生ダンプ先。設定した時だけ書き出す。
# JPAPER_DUMP_RAW=
