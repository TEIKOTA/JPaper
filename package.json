{
  "name": "jpaper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "論文和訳に最適化された決定的専門エージェント",
  "engines": {
    "node": ">=22.5"
  },
  "packageManager": "pnpm@10.30.3",
  "bin": {
    "jpaper": "bin/jpaper.mjs"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "dev:web": "node apps/web/scripts/dev.mjs",
    "build": "tsc -p tsconfig.json && pnpm --filter @jpaper/web build",
    "typecheck": "tsc -p tsconfig.typecheck.json && pnpm --filter @jpaper/web typecheck",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "yaml": "^2.9.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
