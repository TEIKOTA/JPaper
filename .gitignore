# dependencies
node_modules/

# build output
dist/
build/

# environment variables（.env.example はコミットする）
.env
.env.*
!.env.example

# logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# macOS
.DS_Store

# editor
.vscode/*
!.vscode/extensions.json
.idea/

# Claude Code のローカル設定（.claude は .agents への symlink）
.agents/settings.local.json

# TypeScript incremental build info
*.tsbuildinfo

# テストカバレッジ
coverage/

# 実行時に生成されるエージェントの証跡・作業領域（input/ の知識 SSOT はコミットする）
/output/
# 論文ごとの成果物の既定の出力先（ADR 20261007-default-output-under-article-dir）。実行時の生成物なので追跡しない。
/article/
# run ごとの作業領域（source 展開・訳文・LLM トレース）。--out で CWD 直下などへ出した場合も追跡しない。
**/.run/

# 参照用に同梱した別プロジェクト（現行の和訳リポジトリ。JPaper の追跡対象外）
/資料/

# misc
*.local
