# dependencies
node_modules/

# build output
dist/
build/

# environment variables（.env.example はコミットする）
.env
.env.*
!.env.example

# logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# macOS
.DS_Store

# editor
.vscode/*
!.vscode/extensions.json
.idea/

# Claude Code のローカル設定（.claude が実ディレクトリ、.agents は .claude への symlink）
.claude/settings.local.json
.agents/settings.local.json
**/.claude/scheduled_tasks.lock

# TypeScript incremental build info
*.tsbuildinfo

# テストカバレッジ
coverage/

# 実行時に生成されるエージェントの証跡・作業領域（input/ の知識 SSOT はコミットする）
/output/
# run ごとの作業領域（source 展開・訳文・LLM トレース）。既定出力先 <paperId>-ja/ が CWD 直下でも追跡しない。
**/.run/

# 参照用に同梱した別プロジェクト（現行の和訳リポジトリ。JPaper の追跡対象外）
/資料/

# misc
*.local

# Python のバイトコード（hook の判定器を import した検証などで生成される）
__pycache__/
*.pyc
